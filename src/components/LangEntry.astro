---
// Static fallback for the redirecting entry pages: real, crawlable content and a
// working language choice for anyone the JS redirect does not reach.
import { createT } from '../i18n';

const { path = '' } = Astro.props as { path?: string };

const langs = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
  { code: 'fr', label: 'Français' },
];
const t = createT('en');
---

<main id="main" class="min-h-[100svh] flex items-center justify-center py-16">
  <div class="mx-auto w-[85%] md:w-[60%] max-w-none min-w-0 text-center">
    <p class="font-[family-name:var(--font-display)] text-[13px] font-semibold uppercase tracking-[0.12em] text-(--color-accent) mb-6">
      {t('nav.logo')}
    </p>
    <h1 class="font-[family-name:var(--font-display)] text-[clamp(32px,7vw,64px)] font-bold uppercase leading-[0.92] tracking-wide text-(--color-text-head) mb-5">
      {t('meta.default.title')}
    </h1>
    <p class="text-sm leading-relaxed text-(--color-text-muted) max-w-[520px] mx-auto mb-10">
      {t('meta.default.desc')}
    </p>

    <nav aria-label="Choose a language">
      <ul class="flex flex-wrap items-center justify-center gap-3 list-none">
        {langs.map((l) => (
          <li>
            <a
              href={'/' + l.code + path}
              hreflang={l.code}
              lang={l.code}
              class="inline-flex items-center min-h-[44px] px-5 py-2 text-sm tracking-wide border border-(--color-border) rounded text-(--color-text-muted) hover:text-(--color-text-bright) hover:border-(--color-text-muted) transition-colors duration-200"
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</main>
