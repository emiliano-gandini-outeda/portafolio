---
// Language entry point (hreflang x-default). Redirects on the client, but renders
// real content + full SEO metadata so crawlers and no-JS visitors get a usable page
// instead of a bare redirect stub.
import Layout from '../layouts/Layout.astro';
import LangEntry from '../components/LangEntry.astro';
---

<Layout lang="en" route="/">
  <script is:inline>
    (function () {
      var stored = localStorage.getItem('lang');
      var browser = (navigator.language || '').slice(0, 2);
      var lang = stored || (browser === 'es' || browser === 'fr' ? browser : 'en');
      location.replace('/' + lang + location.search + location.hash);
    })();
  </script>
  <LangEntry path="" />
</Layout>
