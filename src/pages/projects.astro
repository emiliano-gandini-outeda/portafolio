---
// Language entry point for /projects (hreflang x-default). See index.astro.
import Layout from '../layouts/Layout.astro';
import LangEntry from '../components/LangEntry.astro';
---

<Layout lang="en" route="/projects/">
  <script is:inline>
    (function () {
      var stored = localStorage.getItem('lang');
      var browser = (navigator.language || '').slice(0, 2);
      var lang = stored || (browser === 'es' || browser === 'fr' ? browser : 'en');
      location.replace('/' + lang + '/projects' + location.search + location.hash);
    })();
  </script>
  <LangEntry path="/projects" />
</Layout>
